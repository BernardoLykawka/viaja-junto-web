# Copie para .env.local e preencha. Nada aqui é segredo: a Web API Key do Firebase é só um identificador do projeto.
VITE_API_URL=http://localhost:8080

# Firebase Authentication (console do Firebase > Configurações do projeto > Seus apps > Web).
# Ative o provedor "Google" em Authentication > Método de login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
